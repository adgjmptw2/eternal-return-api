{
  "name": "eternal-return-api",
  "version": "0.7.1",
  "description": "Unofficial TypeScript client for the Eternal Return Open API, extracted from ERCraft.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "eternal-return-mcp": "./dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "samples",
    "README.md",
    "README.ko.md",
    "GUIDE.md",
    "GUIDE.ko.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "docs": "typedoc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "eternal-return",
    "bser",
    "open-api",
    "game-api",
    "sdk",
    "typescript",
    "mcp"
  ],
  "license": "MIT",
  "author": "김정현 (https://github.com/adgjmptw2)",
  "devDependencies": {
    "@types/node": "22.10.2",
    "typedoc": "0.28.20",
    "typescript": "5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adgjmptw2/eternal-return-api.git"
  },
  "homepage": "https://github.com/adgjmptw2/eternal-return-api#readme"
}
